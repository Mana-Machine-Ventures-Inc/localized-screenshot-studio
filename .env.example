# Optional local/dev fallback. Copy to ".env" in the repo root.
# The supported way to save keys is the studio UI (stored under ~/.lss).
# Real environment variables always take precedence over .env values.
# Never commit .env.

# Fallback if no key has been saved in the UI.
# OPENAI_API_KEY=sk-...

# Optional: OpenAI-compatible endpoint (Azure, a local proxy, etc.).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: translation / generation model (default: gpt-4o-mini).
# LSS_TRANSLATE_MODEL=gpt-4o-mini
# LSS_GEN_MODEL=gpt-4o-mini

# Optional: engine port (default: 8787).
# LSS_PORT=8787
