# Copy this file to ".env" (in the repo root) and fill in your values.
# The engine loads it automatically on startup. Real environment variables
# always take precedence over .env values.

# Enables AI screen generation. Without it, generation uses the deterministic
# offline template.
OPENAI_API_KEY=sk-...

# Optional: OpenAI-compatible endpoint (e.g. Azure, a local proxy).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: generation model (default: gpt-4o-mini).
# LSS_GEN_MODEL=gpt-4o-mini

# Optional: engine port (default: 8787).
# LSS_PORT=8787
